<mujoco model="husky_field">
	<option noslip_iterations="70" />
	<size njmax="8000" nconmax="4000"/>
	<option timestep="0.001"/>
	
	<include file="../robots/husky_panda_hand.xml"/>	
	<asset>
		<texture name="floor_tex" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="100" height="100" />
		<material name="floor_material" texture="floor_tex" texuniform="true" />
	</asset>
	<visual>
        <map force="0.1"/>
    </visual>
	
    
	<default>
        <default class ="viz">
            <geom contype="0" conaffinity="0" group="1" type="mesh" rgba=".6 .6 .7 1" />
        </default>
        <default class="cls">
            <geom group="2" rgba="0.79216 0.81961 0.93333 0.5"/>
        </default>
    </default>
	
	

	<worldbody>		
		<geom name="ground" type="plane" size="5 8 1" pos="0 0 -0.25"  material="floor_material" condim="6"/>

		<light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="1 1 3" dir="-1 -1 -3"/>
		<light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="1 -1 3" dir="-1 1 -3"/>
		<light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="-1 0 3" dir="1 0 -3"/>

		<!-- Path-planner obstacles: geoms named obs_* are auto-loaded into /ns1/obstacles.
		     Base starts at (0,0) facing +x; mode 6/7 goal is (+1.3, +2.5, theta -0.707).
		     The Dubins path is a diagonal corridor from ~(0.3,0.2) up to ~(0.9,2.2); the two
		     pillars below sit on that corridor to force avoidance. Move freely to re-tune
		     (the loader reflects any change on next launch). -->
		<body>
			<geom class="cls" name="obs_pillar1" type="box" pos="0.6 1.0 0.15" size="0.1 0.1 0.15" contype="1" conaffinity="1" rgba="0.3 0.3 0. 1"/>
			<geom class="viz"  type="box" pos="0.6 1.0 0.15" size="0.1 0.1 0.15" rgba="0.6 0.3 0. 1"/>
		</body>
		<body>
			<geom class="cls" name="obs_pillar2" type="box" pos="2.5 1.9 0.15" size="0.1 0.1 0.15" contype="1" conaffinity="1" rgba="0.3 0.3 0. 1"/>
			<geom class="viz"  type="box" pos="2.5 1.9 0.15" size="0.1 0.1 0.15" rgba="0.6 0.3 0. 1"/>
		</body>

	</worldbody>



</mujoco>
